{
  "rewrites": [
    {
      "source": "/gato",
      "destination": "/gato/index.html"
    },
    {
      "source": "/gato/",
      "destination": "/gato/index.html"
    },
    {
      "source": "/gato/en",
      "destination": "/gato/en/index.html"
    },
    {
      "source": "/gato/en/",
      "destination": "/gato/en/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/gato/recordatorio",
      "schedule": "0 22 * * *"
    }
  ]
}
